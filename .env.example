# ── MongoDB Atlas (free M0) ─ Connect → Drivers → copy connection string ──
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shop

# ── Cloudinary (free) ─ Dashboard → API Keys ─────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Server-only secret — never expose it in client code.
CLOUDINARY_API_SECRET=

# ── Admin login (/admin) ─────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-something-long
# Random string, 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ── Store ── name & tagline below are only defaults; edit them in /admin/settings ──
NEXT_PUBLIC_STORE_NAME=Kangan House
NEXT_PUBLIC_STORE_TAGLINE=Handpicked bangles for every wrist and every occasion.
# ISO currency code: INR, USD, PKR, EUR, GBP, AED...
NEXT_PUBLIC_CURRENCY=INR
# Number formatting locale: en-IN, en-PK, en-US, en-GB...
NEXT_PUBLIC_LOCALE=en-IN
# The WhatsApp order number is set in the admin panel: /admin/settings
